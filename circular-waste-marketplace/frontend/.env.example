# =============================================================================
# Circular Waste Marketplace — Frontend Environment Configuration (.env.example)
# =============================================================================
#
# CRITICAL SECURITY NOTICE:
# Vite embeds every VITE_* variable into the client-side JavaScript bundle.
# Anything defined here is PUBLIC and VISIBLE to any user with browser DevTools.
# NEVER put secrets, private keys, database credentials, or server tokens here.
#
# FORBIDDEN IN FRONTEND ENV:
# - JWT_SECRET
# - REFRESH_TOKEN_SECRET
# - DATABASE_URL
# - Any private API keys or provider secrets
# =============================================================================

# Base URL for backend REST API endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for realtime WebSocket connection (reserved for live tracking)
VITE_WS_BASE_URL=ws://localhost:8000

# Application branding name for page titles and metadata
VITE_APP_NAME="Circular Waste Marketplace"

# Enable/disable TanStack Query devtools ("true" in development, "false" in production)
VITE_ENABLE_DEVTOOLS="true"

# Maximum file upload size in megabytes (per image)
VITE_MAX_UPLOAD_MB=10

# === Maps & Live Map (Segment 3.1) ===
VITE_MAP_TILES_PROVIDER=osm
VITE_MAP_TILES_URL_OSM=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_CENTER_LAT=19.0760
VITE_MAP_DEFAULT_CENTER_LNG=72.8777
VITE_MAP_DEFAULT_ZOOM=11

# === Demo Mode (Segment 5.1) ===
# Set to "true" to enable one-click demo persona login buttons on /login
VITE_DEMO_MODE=false
