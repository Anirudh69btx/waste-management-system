# ═══════════════════════════════════════════════════════════════════════
# Circular Waste Marketplace — PRODUCTION env template
# ═══════════════════════════════════════════════════════════════════════
# Copy to .env on the server. NEVER commit the real .env.
# Generate secrets with:
#   openssl rand -hex 32     (for SECRET_KEY, JWT_SECRET, REFRESH_TOKEN_SECRET)
#   openssl rand -base64 24  (for passwords)
# ═══════════════════════════════════════════════════════════════════════

# ──────────────── App ────────────────
APP_NAME=Circular Waste Marketplace
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ──────────────── Database (Postgres 15) ────────────────
# Use strong random password. Store in a password manager.
POSTGRES_USER=cwm
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=cwm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cwm:CHANGE_ME_strong_password@postgres:5432/cwm
DATABASE_URL_SYNC=postgresql://cwm:CHANGE_ME_strong_password@postgres:5432/cwm
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ──────────────── Redis / Celery ────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
AUTH_RATE_LIMIT_STORAGE_URI=redis://redis:6379/3

# ──────────────── MinIO / S3 (production storage) ────────────────
# In production, STORAGE_BACKEND MUST be minio or s3. Never local.
STORAGE_BACKEND=minio
MINIO_ROOT_USER=cwm_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://storage.yourdomain.com
S3_BUCKET=cwm-uploads
S3_ACCESS_KEY=cwm_minio_admin
S3_SECRET_KEY=CHANGE_ME_strong_password
S3_REGION=us-east-1

# ──────────────── JWT / Auth ────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
REFRESH_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32_different_from_above
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_LOGIN=10/minute
AUTH_RATE_LIMIT_REGISTER=3/hour
AUTH_RATE_LIMIT_REFRESH=30/minute

# ──────────────── Backend ────────────────
BACKEND_PORT=8000
RUN_MIGRATIONS=true
LOG_LEVEL=INFO
UPLOAD_DIR=./static/uploads
MAX_UPLOAD_MB=10

# ──────────────── Frontend (Vite — public, no secrets) ────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_WS_BASE_URL=wss://api.yourdomain.com
VITE_APP_NAME=Circular Waste Marketplace
VITE_ENABLE_DEVTOOLS=false
VITE_MAX_UPLOAD_MB=10
VITE_MAP_TILES_PROVIDER=osm
VITE_MAP_TILES_URL_OSM=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_CENTER_LAT=19.0760
VITE_MAP_DEFAULT_CENTER_LNG=72.8777
VITE_MAP_DEFAULT_ZOOM=11

# ──────────────── Map / GPS ────────────────
MAP_TILES_PROVIDER=osm
GPS_SIMULATION_ENABLED=false
GPS_SIMULATION_INTERVAL_SECONDS=10
GPS_PING_RETENTION_HOURS=24
VEHICLE_DEFAULT_CAPACITY_KG=500
ROUTE_SEARCH_MAX_STOPS=10
ROUTE_NEAREST_NEIGHBOR_START_LAT=19.0760
ROUTE_NEAREST_NEIGHBOR_START_LNG=72.8777

# ──────────────── Deployment-specific ────────────────
# Public domain for the app
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
# Email for Let's Encrypt cert notifications
ACME_EMAIL=ops@yourdomain.com
# Optional: Sentry DSN
SENTRY_DSN=
