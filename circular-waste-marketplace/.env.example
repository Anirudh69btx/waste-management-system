# =============================================================================
# Circular Waste Marketplace — Environment Configuration (.env.example)
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Circular Waste Marketplace"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ── Security & Auth ──────────────────────────────────────────────────────────
SECRET_KEY=dev-only-change-in-production-64-chars-hex-do-not-use
JWT_SECRET=dev-only-change-in-production-64-chars-hex-do-not-use
REFRESH_TOKEN_SECRET=dev-only-change-in-production-64-chars-refresh-hex-do-not-use
HMAC_SECRET_KEY=dev-only-change-in-production-64-chars-hmac-key-do-not-use
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
AUTH_RATE_LIMIT_LOGIN=10/minute
AUTH_RATE_LIMIT_REGISTER=5/minute
AUTH_RATE_LIMIT_REFRESH=30/minute
AUTH_RATE_LIMIT_STORAGE_URI=redis://redis:6379/3

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=cwm
POSTGRES_PASSWORD=cwm_dev_password
POSTGRES_DB=cwm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cwm:cwm_dev_password@postgres:5432/cwm
DATABASE_URL_SYNC=postgresql://cwm:cwm_dev_password@postgres:5432/cwm
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_TRACKING_CHANNEL_PREFIX=tracking:transit:

# ── Storage & MinIO / S3 ─────────────────────────────────────────────────────
STORAGE_BACKEND=minio
LOCAL_UPLOAD_DIR=./static/uploads
UPLOAD_DIR=./static/uploads
MAX_UPLOAD_FILE_SIZE_MB=10
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES_PER_INTAKE=5
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=cwm-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_only
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PLATFORM_FEE_PERCENT=2.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MOCK_PAYMENT_DELAY_MS=400
CHECKOUT_HOLD_EXPIRE_MINUTES=15

# ── AI Engine ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
MODEL_REGISTRY_PATH=./ai_engine/models
WASTE_CLASSIFIER_MODEL=waste_clf_v1.onnx
MODEL_VERSION=v1.0.0
IMAGE_QUALITY_MIN_SCORE=0.55
IMAGE_QUALITY_MIN_RESOLUTION=512
PRICING_SUPPLY_DEMAND_WINDOW_HOURS=24
FALLBACK_TO_HEURISTICS=true
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
BIOGAS_VS_FRACTION=0.85
BIOGAS_BMP_M3_PER_KG_VS=0.35

# ── Rewards ──────────────────────────────────────────────────────────────────
POINTS_PER_KG_GRADE_A=10
POINTS_PER_KG_GRADE_B=7
POINTS_PER_KG_GRADE_C=4
POINTS_TO_CURRENCY_RATE=0.01
MAX_REDEMPTION_PERCENT=50.0

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# ── Notifications & Email ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@circular-waste-marketplace.io
SMTP_TLS=true
SMS_PROVIDER=mock

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_ENABLED=true

# ── Maps ─────────────────────────────────────────────────────────────────────
MAPS_PROVIDER=osm
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
TELEMETRY_RETENTION_DAYS=30

# ── Docker & Frontend Ports ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
RUN_MIGRATIONS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_NAME="Circular Waste Marketplace"
VITE_ENABLE_DEVTOOLS=true

# === Segment 3.1: Fleet & Live Map ===
MAP_TILES_PROVIDER=osm
MAP_TILES_URL_OSM=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GPS_SIMULATION_ENABLED=true
GPS_SIMULATION_INTERVAL_SECONDS=10
GPS_PING_RETENTION_HOURS=24
VEHICLE_DEFAULT_CAPACITY_KG=500
ROUTE_SEARCH_MAX_STOPS=10
ROUTE_NEAREST_NEIGHBOR_START_LAT=19.0760
ROUTE_NEAREST_NEIGHBOR_START_LNG=72.8777
